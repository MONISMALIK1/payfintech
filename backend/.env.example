# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Django
SECRET_KEY=replace-with-a-long-random-string-50-chars-min
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (DB_HOST and DB_PORT are set by docker-compose)
DB_NAME=payout_engine
DB_USER=postgres
DB_PASSWORD=replace-with-strong-password
DB_HOST=localhost
DB_PORT=5432

# Redis (REDIS_URL is overridden by docker-compose to redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Payout settings
PAYOUT_IDEMPOTENCY_WINDOW_HOURS=24
PAYOUT_MAX_RETRIES=3
PAYOUT_PROCESSING_TIMEOUT_SECONDS=30
PAYOUT_BANK_FAILURE_RATE=0.2
